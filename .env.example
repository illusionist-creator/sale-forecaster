# Copy to .env on the server and fill in. Never commit .env.

# Public hostname pointing at the server (A record), e.g. forecast.yourcompany.in
DOMAIN=forecast.example.in

# Database password: long and random, e.g. output of `openssl rand -hex 24`
POSTGRES_PASSWORD=change-me

# Login for the site. Generate the hash with:
#   docker run --rm caddy:2.8 caddy hash-password --plaintext 'your-password'
# Keep the single quotes: the hash contains $ characters.
BASIC_AUTH_USER=finance
BASIC_AUTH_HASH='$2a$14$replace.with.generated.hash'

# Time zone used to display version timestamps
GF_TZ=Asia/Kolkata
